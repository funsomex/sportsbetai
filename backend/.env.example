# MongoDB Atlas Connection String
# Obtener en: https://www.mongodb.com/atlas
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/sportsbetai?retryWrites=true&w=majority

# Nombre de la base de datos
DB_NAME=sportsbetai

# CORS - Permitir requests del frontend
# En producción, cambia * por la URL de tu frontend
CORS_ORIGINS=*

# JWT Secret - Genera uno seguro
# Puedes usar: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Telegram Bot Token
# Obtener de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Emergent LLM Key para análisis IA
# Obtener en: https://emergent.sh
EMERGENT_LLM_KEY=sk-emergent-xxxxx
